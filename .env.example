# Copy to .env and fill in. Never commit .env (it is gitignored).
# Production example for the VPS; values in <angle brackets> are yours to choose.

# Django
SECRET_KEY=<long random string: python3 -c "import secrets; print(secrets.token_urlsafe(50))">
ALLOWED_HOSTS=api.attendanceportal.sakibkx.tech
CORS_ALLOWED_ORIGINS=https://attendanceportal.sakibkx.tech
CSRF_TRUSTED_ORIGINS=https://api.attendanceportal.sakibkx.tech
# SECURE_HSTS_SECONDS=31536000   # enable once HTTPS works for good

# PostgreSQL on the same server
DB_NAME=attendanceportal
DB_USER=attendanceportal
DB_PASSWORD=<database password>
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable          # use "require" for a hosted database such as Neon

# Redis on the same server (database 5, kept apart from other sites)
REDIS_URL=redis://127.0.0.1:6379/5

# Face attendance (defaults shown; models are downloaded with `manage.py download_face_models`)
# FACE_ENGINE=insightface
# FACE_MODEL_DIR=/var/www/attendanceportal-backend/face_models
# FACE_MATCH_THRESHOLD=0.45
# FACE_UNSURE_THRESHOLD=0.30
