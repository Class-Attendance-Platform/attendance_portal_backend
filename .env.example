# Copy to .env and fill in. Never commit .env (it is gitignored).
# Production example for the VPS; values in <angle brackets> are yours to choose.
# Comments must be on their own lines: text after a value becomes part of the value.

# Django
SECRET_KEY=<long random string: python3 -c "import secrets; print(secrets.token_urlsafe(50))">
ALLOWED_HOSTS=api.attendanceportal.sakibkx.tech
CORS_ALLOWED_ORIGINS=https://attendanceportal.sakibkx.tech
CSRF_TRUSTED_ORIGINS=https://api.attendanceportal.sakibkx.tech
# Enable once HTTPS works for good:
# SECURE_HSTS_SECONDS=31536000

# PostgreSQL on the same server
DB_NAME=attendanceportal
DB_USER=attendanceportal
DB_PASSWORD=<database password>
DB_HOST=127.0.0.1
DB_PORT=5432
# "disable" for a database on the same server; "require" for a hosted one such as Neon
DB_SSLMODE=disable

# Redis on the same server (database 5, kept apart from other sites)
REDIS_URL=redis://127.0.0.1:6379/5

# Face attendance (defaults shown; models are downloaded with `manage.py download_face_models`)
# FACE_ENGINE=insightface
# FACE_MODEL_DIR=/var/www/attendanceportal-backend/face_models
# FACE_MATCH_THRESHOLD=0.45
# FACE_UNSURE_THRESHOLD=0.30

# Web app address: links in password reset emails and QR codes (no trailing slash)
WEB_URL=https://attendanceportal.sakibkx.tech
# Android app versions (the app asks to update below the minimum)
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
# Attendance below this percent is shown as low
ATTENDANCE_MIN_PERCENT=75

# Password reset by email (Gmail SMTP, smtp.gmail.com:587 TLS). Leave EMAIL_HOST_USER empty to
# turn it off (admins then reset passwords). The password is a Gmail "app password", not the login
# (16 letters, typed without spaces); deploy/README.md "Email for password reset" shows how.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=HSTU Attendance Portal <<gmail address>>

# Request limits (defaults shown). Raise them if a whole class behind one campus IP gets blocked.
# THROTTLE_LOGIN=10/min
# THROTTLE_LOGIN_IP=300/min
# THROTTLE_REGISTER=60/hour
# THROTTLE_PASSWORD_FORGOT=20/hour
# THROTTLE_CHECK_IN=30/min
# Proxies in front of the API (nginx = 1); used to find the visitor's IP for the limits
# NUM_PROXIES=1
