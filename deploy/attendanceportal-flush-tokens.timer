# Runs attendanceportal-flush-tokens.service once a day, at night in Dhaka (no classes then).
# Install: see attendanceportal-flush-tokens.service.
[Unit]
Description=Daily cleanup of expired Attendance Portal sign-in tokens

[Timer]
OnCalendar=*-*-* 03:30:00 Asia/Dhaka
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
